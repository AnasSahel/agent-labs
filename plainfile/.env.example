# GitHub App (user login). Create at https://github.com/settings/apps/new
#   Callback URL: ${BASE_URL}/auth/callback   ·   Repository permissions: Contents = Read-only, Metadata = Read-only
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=plainfile
# Public URL of this deployment (https in production: makes cookies Secure)
BASE_URL=http://localhost:4310
# 16+ random characters; seals the session cookie. `openssl rand -base64 32`
SESSION_SECRET=
PORT=4310
